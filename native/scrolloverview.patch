+// Switch workspace with a short zoom-out: open a non-interactive overview,
+// pan to the target while zooming out slightly, then zoom back in. Falls back
+// to a plain switch whenever the animation would not make sense.
+static SDispatchResult onZoomSwitchDispatcher(std::string arg) {
+    const auto plainSwitch = [&arg]() -> SDispatchResult {
+        const auto RESULT = Config::Actions::changeWorkspace(arg);
+        if (!RESULT)
+            return {.success = false, .error = RESULT.error().message};
+        return {};
+    };
+
+    const auto MONITOR = Desktop::focusState()->monitor();
+    if (!MONITOR || !MONITOR->m_activeWorkspace || MONITOR->m_activeSpecialWorkspace || !ScrollOverview::Config::getValue<int>("animations:enabled"))
+        return plainSwitch();
+
+    // With an overview already open, a plain switch lets it pan to the new
+    // target itself. A transit caught mid zoom-in reopens first, so the
+    // switch keeps animating instead of waiting for the zoom to finish.
+    if (const auto EXISTING = scrollOverviewForMonitor(MONITOR)) {
+        auto* const overview = dynamic_cast<CScrollOverview*>(EXISTING.get());
+        if (overview && overview->isTransit() && overview->isClosing())
+            overview->reopen();
+        return plainSwitch();
+    }
+
+    const auto TARGETID = getWorkspaceIDNameFromString(arg).id;
+    if (TARGETID == WORKSPACE_INVALID || TARGETID == MONITOR->m_activeWorkspace->m_id)
+        return plainSwitch();
+
+    for (const auto& workspace : State::workspaceState()->workspaces()) {
+        if (workspace->m_id != TARGETID)
+            continue;
+        // Switching to a workspace on another output moves focus there;
+        // there is nothing on this monitor to zoom across.
+        if (workspace->m_isSpecialWorkspace || workspace->m_monitor.lock() != MONITOR)
+            return plainSwitch();
+        break;
+    }
+
+    const auto OPENED  = openOverview(MONITOR);
+    auto* const overview = OPENED.overview ? dynamic_cast<CScrollOverview*>(OPENED.overview.get()) : nullptr;
+    if (!overview || !OPENED.created)
+        return plainSwitch();
+
+    overview->beginTransit();
+    const auto RESULT = plainSwitch();
+    if (!RESULT.success)
+        overview->dismissTransient();
+    return RESULT;
+}
